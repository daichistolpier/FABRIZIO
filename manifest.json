{
    "manifest_version" : 3,
    "name" : "Fabrizio: your Microsoft Fabric assistant",
    "version" : "1.0.0",
    "icons": {
    "16": "img/moustache.png",
    "32": "img/moustache.png",
    "48": "img/moustache.png",
    "128": "img/moustache.png"
  },
  "permissions": [
    "tabs",
    "sidePanel",
    "activeTab",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "side_panel": {
    "default_path": "./panel/panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.fabric.microsoft.com/*",
        "https://app.powerbi.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://app.fabric.microsoft.com/*",
    "https://app.powerbi.com/*"
  ],
  "action": {},
  "options_ui": {
    "page": "./options/options.html",
    "open_in_tab": true
  }
}